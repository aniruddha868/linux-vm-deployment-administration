[Unit]
Description=DevOps Telemetry Collector Service
After=network.target network-online.target
Wants=network-online.target
Documentation=https://github.com/aniruddha868/linux-vm-deployment-administration

[Service]
Type=simple
# Dedicated unprivileged service user and group for security isolation
User=metric-collector
Group=monitors

# Working directory and execution command
WorkingDirectory=/opt/devops-metrics
ExecStart=/opt/devops-metrics/scripts/01-system-info.sh

# Restart policy: automatically restart on failure after 5 seconds
Restart=on-failure
RestartSec=5s

# Security hardening directives for systemd
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true

# Standard output and error logging to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=devops-metrics

[Install]
WantedBy=multi-user.target
